{
  "rewrites": [
    {
      "source": "/judge/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/overlay/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/dev/design",
      "destination": "/index.html"
    },
    {
      "source": "/developers/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
