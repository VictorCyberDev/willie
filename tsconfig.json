{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "apps",
    "packages",
    "tests",
    "scripts",
    "*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}