{
  "name": "willie",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:property": "vitest run tests/domain.property.test.ts",
    "test:integration": "vitest run tests/db.integration.test.ts",
    "test:contracts": "vitest run tests/contracts.test.ts",
    "test:e2e": "playwright test",
    "test:m9": "vitest run tests/m9.test.ts && playwright test",
    "adapter:test": "vitest run tests/adapters.test.ts",
    "build": "vite build --config apps/web/vite.config.ts && tsc -p tsconfig.server.json && node scripts/copy-sql.mjs",
    "dev": "node --env-file-if-exists=.env --import tsx apps/server/src/index.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx packages/db/src/cli.ts",
    "seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "docker:build": "docker build -t willie:local .",
    "start": "node --env-file-if-exists=.env dist/server/apps/server/src/index.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.7",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.3",
    "zod": "^4.1.12",
    "@willie/sdk": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.9.1",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.38.0",
    "fast-check": "^4.3.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
